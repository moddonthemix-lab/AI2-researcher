# Copy to .env (or export in your shell). All optional.
SCHOLAR_MODEL=qwen2.5:7b            # any Ollama model with tool support; qwen2.5:14b if your Mac has 32GB+
SCHOLAR_OLLAMA_URL=http://localhost:11434
SCHOLAR_HOME=~/.scholar             # scholar.db + reports/ live here
SCHOLAR_NAME=Scholar
SCHOLAR_USER=boss
SCHOLAR_SEARXNG_URL=                # e.g. http://localhost:8888 — your own private metasearch (recommended)
SCHOLAR_TOR_PROXY=                  # e.g. 127.0.0.1:9050 — lets Scholar read .onion sources through Tor
SCHOLAR_API_HOST=127.0.0.1          # 0.0.0.0 to let the other family members reach him on your LAN
SCHOLAR_API_PORT=8766               # Amo uses 8765
SCHOLAR_API_TOKEN=                  # set this before exposing the API on your network
